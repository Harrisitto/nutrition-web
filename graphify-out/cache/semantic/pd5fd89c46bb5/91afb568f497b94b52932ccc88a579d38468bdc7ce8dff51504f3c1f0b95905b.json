{"nodes": [{"id": "supabase_solution_readme_stripe_supabase_deployment_guide", "label": "Stripe-Supabase Integration Deployment Guide", "file_type": "document", "source_file": "supabase/solution/README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not yet deployed; web code already assumes these changes. Fixes paywall and customer portal bugs from the old supabase/intagration versions."}, {"id": "supabase_solution_readme_supabase_project", "label": "Supabase Project iivsjutltecehnnhmjok (sports-nutrition)", "file_type": "concept", "source_file": "supabase/solution/README.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "supabase_solution_readme_create_stripe_checkout", "label": "create-stripe-checkout Edge Function", "file_type": "code", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces customer_email checkout that created a new Customer every time; reuses/creates Customer with metadata.supabase_user_id, blocks duplicate subscriptions, validates redirect URLs against ALLOWED_ORIGINS."}, {"id": "supabase_solution_readme_create_stripe_portal", "label": "create-stripe-portal Edge Function", "file_type": "code", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-heals Customer metadata and derives return_url from Origin instead of defaulting to localhost:5173."}, {"id": "supabase_solution_readme_update_stripe_amount", "label": "update-stripe-amount Edge Function (seat sync)", "file_type": "code", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously an empty file so billed seats never updated. Deployed with --no-verify-jwt because Postgres calls it; protected by X-Sync-Secret (SEAT_SYNC_SECRET). Uses proration_behavior create_prorations."}, {"id": "supabase_solution_readme_seats_trigger", "label": "01_seats_trigger.sql (tr_sync_stripe_seats on all_users)", "file_type": "code", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old trigger sent net.http_post without auth (silent 401) and fired on any UPDATE of all_users; new one reads seat_sync_secret and seat_sync_apikey from Vault rather than embedding them in pg_catalog-readable function source."}, {"id": "supabase_solution_readme_has_active_subscription", "label": "has_active_subscription() (02_subscription.sql)", "file_type": "code", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old version joined via subscriptions.metadata which is missing for subscriptions created outside checkout; new one uses customer metadata.supabase_user_id with subscriptions.metadata fallback. Apply before 01 trigger."}, {"id": "supabase_solution_readme_tiered_seat_pricing", "label": "Tiered Seat Pricing (Stripe price, quantity = clients)", "file_type": "concept", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single plan; amount derives from quantity: 5 EUR/month up to 5 clients, then 25 EUR/month + 2 EUR per client. Tiers must be configured in the Stripe Price (billing_scheme tiered), not in code."}, {"id": "supabase_solution_readme_customer_metadata_backfill", "label": "Stripe Customer metadata.supabase_user_id Backfill", "file_type": "rationale", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must run before replacing has_active_subscription() or paying nutritionists get locked out; metadata is written in Stripe and mirrored to stripe.customers by the sync engine. Only non-reversible but additive step."}, {"id": "supabase_solution_readme_nutritionist_paywall", "label": "Nutritionist Subscription Paywall", "file_type": "concept", "source_file": "supabase/solution/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After completing nutritionist profile the paywall blocks inviting clients until subscription is active; frontend polls up to 60s for the webhook after checkout."}], "edges": [{"source": "supabase_solution_readme_stripe_supabase_deployment_guide", "target": "supabase_solution_readme_supabase_project", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/solution/README.md", "source_location": "L7", "weight": 1.0}, {"source": "supabase_solution_readme_stripe_supabase_deployment_guide", "target": "supabase_solution_readme_create_stripe_checkout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/solution/README.md", "source_location": null, "weight": 1.0}, {"source": "supabase_solution_readme_stripe_supabase_deployment_guide", "target": "supabase_solution_readme_create_stripe_portal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/solution/README.md", "source_location": null, "weight": 1.0}, {"source": "supabase_solution_readme_stripe_supabase_deployment_guide", "target": "supabase_solution_readme_update_stripe_amount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "supabase/solution/README.md", "source_location": null, "weight": 1.0}, {"source": "supabase_solution_readme_stripe_supabase_deployment_guide", "target": "supabase_solut