{"nodes": [{"id": "src_assets_screenshots_screenshot_web_dashboard", "label": "Web Dashboard Screenshot", "file_type": "image", "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_assets_screenshots_screenshot_web_dashboard_weekly_meal_plan_grid", "label": "Weekly Meal Plan Grid (meal slots x weekdays)", "file_type": "concept", "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows are meal slots (Entrenamiento de tarde, Cena, Picar, Pre entrenamiento, Recuperador, Merienda) and columns are weekdays Lunes-Domingo; each cell shows a meal code such as CC 2 or DES 1, with colored borders highlighting variants (e.g. CC 3 / DES 3)."}, {"id": "src_assets_screenshots_screenshot_web_dashboard_meal_codes", "label": "Meal Codes (CC / DES level)", "file_type": "concept", "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meals are referenced by compact category+level codes (e.g. CC 2 for dinner, DES 1 for snack); higher levels appear on high-demand days (Saturday DES 3), suggesting intake level scales with training load."}, {"id": "src_assets_screenshots_screenshot_web_dashboard_carbs_per_training_hour", "label": "Carbohidratos por hora de entrenamiento", "file_type": "concept", "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Section listing grams of carbs per training hour (1h-5h) per day, plus Kcal de entrenamiento; Saturday shows a long session (100/150/60/20 g) versus 60 g/h on other days."}, {"id": "src_assets_screenshots_screenshot_web_dashboard_energy_balance", "label": "Balance energetico (daily and weekly)", "file_type": "concept", "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily kcal energy balance per weekday (e.g. 1491-2659 kcal) with a Balance semanal total column (11971 kcal); the peak day coincides with the longest training day."}, {"id": "src_assets_screenshots_screenshot_web_dashboard_daily_macronutrients", "label": "Macronutrientes diarios (carbs per kg)", "file_type": "concept", "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily macronutrient rows such as Carbohidratos/kg (6.40-7.43) with a Promedio semanal weekly average column (6.71)."}, {"id": "src_assets_screenshots_screenshot_web_dashboard_green_table_theme", "label": "Dark-green tabular dashboard layout", "file_type": "concept", "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spreadsheet-like layout with dark-green headers and row labels, light cells, section header bands spanning the week, and a right-hand weekly summary column; Spanish UI served at localhost:5173/#/dashboard (Vite dev server, hash routing)."}], "edges": [{"source": "src_assets_screenshots_screenshot_web_dashboard", "target": "src_assets_screenshots_screenshot_web_dashboard_weekly_meal_plan_grid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/assets/screenshots/screenshot-web-dashboard.png", "source_location": null, "weight": 1.0}, {"source": "src_assets_screenshots_screenshot_web_dashboard", "target": "src_assets_screenshots_screenshot_web_dashboard_carbs_per_training_hour", "relation": "ref